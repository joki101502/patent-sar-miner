# Patent SAR Miner — example environment file
#
# EVERY VARIABLE HERE IS OPTIONAL. The application must run correctly with no
# .env.local file present at all.
#
# This system requires NO API keys, NO database credentials, and NO accounts.
# That is by design — see PRD.md §4.3 (Out of Scope): paid APIs and frontier
# LLM/VLM calls are both explicitly banned, so every external call the system
# makes is anonymous.
#
# Copy to .env.local and edit only if you need to override something.
# .env.local must be gitignored and never committed.

# ---------------------------------------------------------------------------
# HuggingFace (optional)
# ---------------------------------------------------------------------------
# All models used are PUBLIC and download anonymously:
#   yujieq/MolScribe
#   microsoft/table-transformer-structure-recognition-v1.1-all
#   ds4sd/MolClassifier
#   Ozymandias314/MolDetect
#
# A public READ token only helps if you hit anonymous rate limits during
# repeated clean builds. It is NOT needed at runtime: the slim checkpoint is
# produced once at build time and baked in (PRD R17.9 / Plan Part 7.1).
HF_TOKEN=
HF_HOME=

# ---------------------------------------------------------------------------
# Assay roles — THE ONLY VARIABLES THAT CHANGE RESULTS, NOT PLUMBING
# ---------------------------------------------------------------------------
# These set the sign of the selectivity score (PRD R12.4:
#   selectivity = bin_score(target) - bin_score(off_target)).
# Getting them backwards ranks the wrong compounds first.
# Defaults below are correct for the reference patent WO2024097932A1, where
# WIZ is the intended degradation target and ZBTB7A the off-target.
SARMINE_TARGET_ASSAY=WIZ
SARMINE_OFF_TARGET_ASSAY=ZBTB7A

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
SARMINE_ARTIFACT_ROOT=./artifacts
SARMINE_MOLSCRIBE_CKPT=./models/molscribe_slim.pth
SARMINE_ASSAY_LEXICON=./sarmine/data/assay_lexicon.yaml

# ---------------------------------------------------------------------------
# Thresholds
# ---------------------------------------------------------------------------
# Placeholder. MUST be calibrated against the gold set in Plan Part 13
# (PRD R13.2). Gate on MINIMUM atom/bond confidence, not the molecule mean
# (PRD R13.1) — one wrong atom ruins a structure while barely moving the mean.
SARMINE_OCSR_CONF_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# System binaries — override only if not on PATH
# ---------------------------------------------------------------------------
# macOS note: /usr/bin/java is a STUB that prints an install prompt and exits.
# It is not a JRE. Install a real JDK (brew install openjdk) or py2opsin fails
# confusingly. See Plan Part 0.1.
SARMINE_TESSERACT_BIN=tesseract
SARMINE_JAVA_BIN=java
SARMINE_POPPLER_BIN_DIR=
